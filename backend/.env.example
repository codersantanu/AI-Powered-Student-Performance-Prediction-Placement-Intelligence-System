# Flask API secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# MySQL Server running locally as an Ubuntu system service.
# Create the separate studentiq_app database and a dedicated app user first.
DATABASE_URL=mysql+pymysql://studentiq_app:CHANGE_ME@127.0.0.1:3306/studentiq_app?charset=utf8mb4

# Frontend origins allowed to call the Flask API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Keep the model file outside source control; set this to your local trusted artifact.
MODEL_PATH=backend/artifacts/studentiq_model.joblib

# Optional cookie auth mode: bearer (default) or cookie (requires HTTPS in production).
JWT_AUTH_MODE=bearer
